{
  "multipart": [
    {
      "apply": {
        "model": "dfc:block/rock/column/gabbro_center_bottom"
      },
      "when": {
        "down": "true"
      }
    },
    {
      "apply": {
        "model": "dfc:block/rock/column/gabbro_center_bottom"
      },
      "when": {
        "down": "false",
        "style": "doric|ionic|corinthian"
      }
    },
    {
      "apply": {
        "model": "dfc:block/rock/column/gabbro_center_bottom_tuscan"
      },
      "when": {
        "down": "false",
        "style": "tuscan"
      }
    },
    {
      "apply": {
        "model": "dfc:block/rock/column/gabbro_center_middle_top"
      },
      "when": {
        "style": "doric|ionic",
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "dfc:block/rock/column/gabbro_center_middle_top_corinthian"
      },
      "when": {
        "style": "corinthian",
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "dfc:block/rock/column/gabbro_center_middle_top_tuscan"
      },
      "when": {
        "style": "tuscan",
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "dfc:block/rock/column/gabbro_center_top"
      },
      "when": {
        "style": "doric|ionic|corinthian",
        "up": "false"
      }
    },
    {
      "apply": {
        "model": "dfc:block/rock/column/gabbro_center_top_tuscan"
      },
      "when": {
        "style": "tuscan",
        "up": "false"
      }
    },
    {
      "apply": {
        "model": "dfc:block/rock/column/gabbro_top"
      },
      "when": {
        "style": "doric|tuscan",
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "dfc:block/rock/column/gabbro_top_ionic_x"
      },
      "when": {
        "axis": "x",
        "style": "ionic",
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "dfc:block/rock/column/gabbro_top_ionic_z"
      },
      "when": {
        "axis": "z",
        "style": "ionic",
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "dfc:block/rock/column/gabbro_top_corinthian"
      },
      "when": {
        "style": "corinthian",
        "up": "true"
      }
    }
  ]
}